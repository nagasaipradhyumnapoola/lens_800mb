<?xml version="1.0" encoding="utf-8"?>
<!-- Lens phone screen observation: window content of the app in front, only while the user has enabled this service
     in Android settings and switched "Observe phone screen" on in Lens. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowContentChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="500"
    android:description="@string/screen_observer_description" />
